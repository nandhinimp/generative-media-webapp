generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Generation {
  id        Int      @id @default(autoincrement())
  prompt    String
  imageUrl  String
  createdAt DateTime @default(now())
  deletedAt DateTime?
}

model SavedEdit {
  id                Int      @id @default(autoincrement())
  sourceGenerationId Int
  prompt            String
  imageUrl          String
  createdAt         DateTime @default(now())
  deletedAt         DateTime?
}