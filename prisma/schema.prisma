generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Generation {
  id        Int      @id @default(autoincrement())
  userId    String
  userName  String?
  userImage String?
  prompt    String
  imageUrl  String
  createdAt DateTime @default(now())
  deletedAt DateTime?

  @@index([userId, createdAt])
}

model SavedEdit {
  id                Int      @id @default(autoincrement())
  userId            String
  userName          String?
  userImage         String?
  sourceGenerationId Int
  prompt            String
  imageUrl          String
  createdAt         DateTime @default(now())
  deletedAt         DateTime?

  @@index([userId, createdAt])
}